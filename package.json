{
  "name": "zerpa-erp",
  "version": "3.0.0",
  "description": "ZERPA — modular multi-vertical CRM platform for South Africa (web)",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/web",
    "packages/shared-types",
    "packages/vertical-manifests"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "npm run dev -w zerpa-web",
    "build": "turbo build",
    "start": "turbo start",
    "test": "turbo test",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "verify": "turbo run lint build test"
  },
  "devDependencies": {
    "@turbo/gen": "^1.10.0",
    "next": "^15.0.0",
    "prettier": "^3.0.0",
    "turbo": "^1.10.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
